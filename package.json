{
  "name": "pin2pin-global",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Pin2Pin Global — Datasheet-verified semiconductor cross-reference and pin-compatible alternative engineering database",
  "scripts": {
    "verify:schema": "node pipeline/stage2_physics_verifier.mjs --all",
    "sync:manifest": "node pipeline/sync_manifest.mjs",
    "build:xref": "node pipeline/stage3_xref_engine.mjs",
    "qa:gate": "node pipeline/stage5_qa_gate.mjs",
    "health:check": "node pipeline/health_monitor.mjs",
    "web:dev": "npm --prefix web run dev",
    "web:build": "npm --prefix web run build",
    "deploy:gh-pages": "powershell -ExecutionPolicy Bypass -File scripts/deploy-gh-pages.ps1"
  },
  "dependencies": {
    "zod": "^3.24.2"
  }
}
