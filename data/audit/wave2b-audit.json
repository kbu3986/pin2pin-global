  "key_traps_discovered": [
    {
      "trap": "onsemi LM358DR2G 250 V HBM ESD Anomaly vs 2000 V HBM LM358EDR2G & LM393DR2G",
      "parts": ["LM358DR2G", "LM393DR2G"],
      "detail": "300 DPI PNG Vision on onsemi LM358/D Rev. 36 p.3 caught that standard LM358DG/DR2G and LM2904DG/DR2G are rated ONLY 250 V HBM / 100 V MM (8x lower than LM358EDR2G's 2000 V HBM and LM393DR2G Rev. 35's 2000 V HBM / 750 V CDM). Vision on p.6 Fig. 3 & Fig. 5 also extracted typical 1.0 MHz GBWP and ~0.6 V/us slew rate omitted from p.4 tables."
    },
    {
      "trap": "TLV75733PDBVR 1 A Thermal Illusion in Non-EP DBV SOT-23-5 (231.1 °C/W) & Foldback Startup",
      "parts": ["TLV75733PDBVR"],
      "detail": "At 5 V -> 3.3 V @ 1 A, 1.7 W dissipation causes ΔT = 393 °C on standard DBV JEDEC (231.1 °C/W), restricting sustained 5 V->3.3 V current to <= 250 mA unless moving to exposed-pad DYD (60.3 °C/W EVM / 92.5 °C/W JEDEC). Foldback current limit (755 mA typ) can also stall constant-current loads below 0.4 * VOUT."
    },
    {
      "trap": "TPS7A2433DBVR Fast Line-Transient Brief Shutdown (Sec. 8.1.8) & High-Z Shutdown Output",
      "parts": ["TPS7A2433DBVR"],
      "detail": "Large/fast VIN steps can trigger a brief few-hundred-microsecond shutdown (p.17 Fig. 8-3). Additionally, its active overshoot pulldown disables when VEN < VEN(LOW) leaving VOUT high-Z in shutdown (p.12), and 167.8 °C/W RθJA severely caps 12–18 V continuous load far below 200 mA."
    },
    {
      "trap": "NCP1117LPST33T3G Retains 20 mOhm–20 Ohm ESR Floor & 1.3–1.4 V Dropout Despite 10x Lower IQ",
      "parts": ["NCP1117LPST33T3G"],
      "detail": "Despite cutting IQ to 550 uA typ, Table 1 (p.2) and p.10 still enforce 20 mOhm <= ESR <= 20 Ohm (bare MLCCs risk oscillation), dropout is 1.3 V typ / 1.4 V max at 1 A (tight on 5 V ±5% rails), VIN abs max drops to 18 V, and thermal tab Pin 4 stays tied to VOUT."
    },
    {
      "trap": "TPS563208DDCR FCCM 12% Light-Load Efficiency vs AP62300WU-7 8.0 V EN Ceiling & 0.800 V VREF",
      "parts": ["TPS563208DDCR", "AP62300WU-7"],
      "detail": "Both share the 1=GND, 2=SW, 3=VIN, 4=FB, 5=EN, 6=BST 6-pin layout, yet TPS563208DDCR runs FCCM (350 uA IQ, ~12% @ 5 mA, 19 V EN with 1.5 MOhm pulldown, 0.768 V VFB) while AP62300WU-7 runs PFM (155 uA IQ, 83% @ 5 mA, 8.0 V EN abs max float-ON, 0.800 V VFB—and SOT563 Z6 swaps Pins 1/3 & 4/6)."
    },
    {
      "trap": "TL082IDR Rev O Mixed SFAB/RFB Die Lottery & 37 nV/rtHz Audio Noise Convergence With TL072IDR",
      "parts": ["TL082IDR"],
      "detail": "SLOS081O (Sep 2025) Table 9-1 confirms non-H TL082IDR reels ship either legacy SFAB or modern RFB silicon (shifting 1 kHz noise from 18 to 37 nV/rtHz, lowering HBM ESD to ±1500 V, and adding ±10 mA input clamp diodes). Specify TL082HIDR for deterministic modern RFB silicon."
    }
  ]
