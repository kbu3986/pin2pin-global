  "lm358_vs_lm393_trap_verification": {
    "package": "SOIC-8 (D)",
    "pinout_identical": true,
    "verified_pinout": "1=OUT_A, 2=IN_NEG_A, 3=IN_POS_A, 4=VEE(V-/GND), 5=IN_POS_B, 6=IN_NEG_B, 7=OUT_B, 8=VCC(V+/VCC)",
    "lm358dr_device_kind": "opamp",
