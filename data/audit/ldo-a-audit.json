  "key_traps_discovered": [
    {
      "trap": "3-Way Incompatible SOT-23-3 Pinout Matrix Across 5 OPNs",
      "parts": ["LM3480IM3-3.3/NOPB", "AP7333-33SAG-7", "AP7313-33SAG-7", "AP7313-33SRG-7", "AP2210N-3.3TRG1"],
      "detail": "Three mutually incompatible SOT-23-3 pinouts verified via 300 DPI PNG Vision: Group A (1=IN, 2=OUT, 3=GND: AP7333-33SAG-7, AP7313-33SAG-7), Group B (1=GND, 2=OUT, 3=IN: AP7313-33SRG-7, AP2210N-3.3TRG1), Group C (1=OUT, 2=IN, 3=GND: LM3480IM3-3.3/NOPB)."
    },
    {
      "trap": "Single-Letter SA vs SR Ordering Suffix Changes Both Pinout AND Thermal Rating",
      "parts": ["AP7313-33SAG-7", "AP7313-33SRG-7"],
      "detail": "Within the same AP7313 datasheet, SA (SOT23) is 1=IN/2=OUT/3=GND with θJA=207 C/W & PD=600 mW, whereas SR (SOT23R) reverses Pins 1 & 3 to 1=GND/2=OUT/3=IN with θJA=230 C/W & PD=540 mW."
    },
    {
      "trap": "SOT-23-5 Pin 4 BYP (<=100 pF) vs NC & Non-Ceramic ESR Boundary",
      "parts": ["AP2210K-3.3TRG1", "AP2112K-3.3TRG1", "TPS7A2033PDBVR"],
      "detail": "AP2210K-3.3TRG1 uses Pin 4 as internal bandgap BYP (max 100 pF, not 10 nF and not NC; tying Pin 4 to GND like TLV700/NCP114 thermal advice collapses VOUT). AP2210 also has a ~25 mOhm lower ESR stability floor (Page 22) and 4 mA typ bipolar IGND at 300 mA."
    },
    {
      "trap": "Front-Page Package-Specific Spec Inflation (AUD-02)",
      "parts": ["TLV75533PDBVR", "NCP114ASN330T1G", "TPS7A2033PDBVR"],
      "detail": "TLV755P Page 1 headlines 60.3 C/W RθJA (DYD exposed-pad EVM only), while standard DBV SOT-23-5 is 231.1 C/W JEDEC (100.8 C/W EVM). NCP114 Page 1 headlines 135 mV dropout (UDFN4 only), while TSOP-5 (NCP114ASN330T1G) is 150 mV typ / 225 mV max and 236 C/W. TPS7A20 DBV dropout is 145 mV max vs 140 mV for DQN/DSBGA."
    },
    {
      "trap": "EN Sequencing & VOUT Abs Max Constraints Across Pin-Compatible SOT-23-5 Parts",
      "parts": ["TLV70033DDCR", "TLV73333PDBVR", "TPS7A0233PDBVR"],
      "detail": "TLV70033DDCR and TLV73333PDBVR forbid VEN > VIN + 0.3 V (and TLV73333PDBVR caps VOUT abs max at just 3.6 V!), whereas TPS7A02/TPS7A20/TLV755P allow independent VEN up to 6.0–6.5 V. TPS7A02 also imposes a strict 22 uF maximum derated COUT cap."
    }
  ]
